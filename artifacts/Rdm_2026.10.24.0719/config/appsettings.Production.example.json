{
  "ConnectionStrings": {
    "SqlServer": "Server=<SQL_HOST>,<PORT>;Database=trdm;User Id=rdmuser;Password=<SQL_PASSWORD>;Encrypt=True;TrustServerCertificate=True;Application Name=Rdm"
  },
  "Sap": {
    "DestinationName": "PRD",
    "AppServerHost": "<SAP_APP_SERVER_IP>",
    "SystemNumber": "<SYSNR>",
    "SystemId": "<SID>",
    "Client": "<CLIENT>",
    "User": "<RFC_USER>",
    "Password": "<RFC_PASSWORD>",
    "Language": "EN",
    "PoolSize": 10,
    "PriceBapiChunkSize": 50
  },
  "Jwt": {
    "Issuer": "Rdm.Api",
    "Audience": "Rdm.Api.Clients",
    "SigningKey": "<TU_SINH_KHI_TAO>",
    "ExpiryMinutes": 60
  },
  "Auth": {
    "BootstrapAdmin": {
      "Username": "admin",
      "Password": "<ADMIN_PASSWORD>"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ApiEndpoints": {
    "DefaultActive": true,
    "RefreshSeconds": 30
  },
  "Swagger": {
    "Enabled": true
  },
  "Hangfire": {
    "WorkerCount": 2,
    "QueuePollSeconds": 15,
    "ShutdownTimeoutSeconds": 120
  },
  "Jobs": {
    "LogRetentionCron": "0 2 * * *",
    "LogRetentionDays": 30,
    "MasterDataSyncCron": "0 1 * * *"
  }
}
