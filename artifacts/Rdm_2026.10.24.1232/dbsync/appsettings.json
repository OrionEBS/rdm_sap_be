{
  // Rdm.DbSync — đồng bộ dữ liệu DB RDM sang DB khác. Mật khẩu: đặt ở file --config / RDM_CONFIG_FILE / biến môi trường
  // (DbSync__TargetConnectionString), không sửa file này trong gói.
  "DbSync": {
    // DB nguồn. Trống = ConnectionStrings:SqlServer.
   "SourceConnectionString": "",
    "TargetConnectionString": "",
    // md.* = toàn bộ master data; rdm.ApiEndpoints = bật / tắt + mô tả đối tác; thêm "rdm.ApiUsers" nếu muốn chép tài khoản.
    "Tables": [ "md.*", "rdm.ApiEndpoints" ],
    // IfEmpty: chỉ nạp bảng đích đang trống, không đè cấu hình API đã chỉnh bên đích. Replace: thay toàn bộ (cần --yes).
    "Mode": "IfEmpty"
  }
}
