# Địa chỉ RDM API khi BUILD (FE host riêng). Trống = cùng origin với trang (VD đặt FE sau reverse proxy chung domain).
# VD: VITE_API_BASE_URL=https://rdm-api.tafico.local:8443
# Nhớ khai báo origin của FE trong cấu hình API: "Cors": { "AllowedOrigins": [ "https://rdm-admin.tafico.local" ] }
VITE_API_BASE_URL=

# Chỉ dùng khi chạy dev (npm run dev): proxy /api → API này.
VITE_API_PROXY=http://localhost:5200
